<Window x:Class="Lanceur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanceur" Width="1040" Height="660" MinWidth="600" MinHeight="420"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menu contextuel d'une tuile -->
        <ContextMenu x:Key="TileMenu" x:Shared="False">
            <MenuItem Header="Lancer" Tag="&#xE768;" Click="MenuLaunch_Click" InputGestureText="Clic"/>
            <MenuItem Header="Exécuter en tant qu'administrateur" Tag="&#xE7EF;" Click="MenuLaunchAdmin_Click"/>
            <MenuItem Header="Ouvrir l'emplacement du fichier" Tag="&#xE838;" Click="MenuOpenLocation_Click"/>
            <Separator/>
            <MenuItem Header="Modifier…" Tag="&#xE70F;" Click="MenuEdit_Click"/>
            <MenuItem Header="Dupliquer" Tag="&#xE8C8;" Click="MenuDuplicate_Click"/>
            <Separator/>
            <MenuItem Header="Supprimer" Tag="&#xE74D;" Click="MenuDelete_Click" Style="{StaticResource DangerMenuItem}"/>
        </ContextMenu>

        <!-- Menu contextuel d'un groupe -->
        <ContextMenu x:Key="GroupMenu" x:Shared="False">
            <MenuItem Header="Renommer…" Tag="&#xE8AC;" Click="GroupRename_Click"/>
            <MenuItem Header="Monter" Tag="&#xE70E;" Click="GroupUp_Click"/>
            <MenuItem Header="Descendre" Tag="&#xE70D;" Click="GroupDown_Click"/>
            <Separator/>
            <MenuItem Header="Supprimer le groupe" Tag="&#xE74D;" Click="GroupDelete_Click" Style="{StaticResource DangerMenuItem}"/>
        </ContextMenu>

        <!-- Tuile -->
        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Tile" Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}" Margin="0,0,12,12"
                    CornerRadius="12" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="700"
                    ContextMenu="{StaticResource TileMenu}" AllowDrop="True"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                    DragEnter="Tile_DragEnter" DragLeave="Tile_DragLeave" DragOver="Area_DragOver" Drop="Tile_Drop">
                <Grid>
                    <!-- Liseré de couleur -->
                    <Border Height="3" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,3,3"
                            Background="{Binding ColorBrush}"/>

                    <StackPanel VerticalAlignment="Center" Margin="8,10,8,6">
                        <Grid Width="{DynamicResource TileIconSize}" Height="{DynamicResource TileIconSize}" HorizontalAlignment="Center">
                            <Border x:Name="Monogram" CornerRadius="10" Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                                <TextBlock Text="{Binding Monogram}" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <Image x:Name="IconImage" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" FontSize="{DynamicResource TileFontSize}"
                                   Foreground="{DynamicResource TextPrimary}" LineStackingStrategy="BlockLineHeight" LineHeight="17"/>
                    </StackPanel>

                    <!-- Badge administrateur -->
                    <TextBlock x:Name="AdminBadge" Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="9,9,0,0" Visibility="Collapsed" ToolTip="Exécuté en tant qu'administrateur"/>

                    <!-- Bouton modifier (au survol) -->
                    <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="12"
                            Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                            Visibility="Hidden" ToolTip="Modifier" Click="TileEdit_Click"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Monogram" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunAsAdmin}" Value="True">
                    <Setter TargetName="AdminBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceHoverBg}"/>
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Margin" To="0,-3,12,15" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Margin" To="0,0,12,12" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Élément de la liste des groupes -->
        <Style x:Key="GroupItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="ContextMenu" Value="{StaticResource GroupMenu}"/>
            <EventSetter Event="MouseDoubleClick" Handler="GroupItem_DoubleClick"/>
            <EventSetter Event="DragEnter" Handler="GroupItem_DragEnter"/>
            <EventSetter Event="DragLeave" Handler="GroupItem_DragLeave"/>
            <EventSetter Event="DragOver" Handler="Area_DragOver"/>
            <EventSetter Event="Drop" Handler="GroupItem_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Margin="0,1" Padding="12,9" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="-12,0,9,0"
                                        Background="{DynamicResource Accent}" Visibility="Hidden"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Items.Count}" Margin="8,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Barre latérale ============ -->
            <Grid Background="{DynamicResource SidebarBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,14,0,0" Height="40">
                    <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Lanceur" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="18,18,10,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" Width="26" Height="26"
                            FontSize="12" ToolTip="Nouveau groupe" Click="AddGroup_Click"/>
                    <TextBlock Text="GROUPES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox x:Name="GroupList" Grid.Row="2" Margin="10,0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource GroupItemStyle}" SelectionChanged="GroupList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <StackPanel Grid.Row="3" Margin="10,8,10,14">
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="Settings_Click"
                            ToolTip="Paramètres (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="Paramètres" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Contenu ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Boutons de fenêtre -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Content="&#xE718;" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Toujours au premier plan" Click="Pin_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Réduire" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Agrandir" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Fermer" Click="Close_Click"/>
                </StackPanel>

                <!-- En-tête -->
                <Grid Grid.Row="1" Margin="32,4,32,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Mon tableau de bord" FontSize="26" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid Width="250">
                            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Padding="34,8,30,8"
                                     Tag="Rechercher… (Ctrl+F)" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="13,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                    Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,5,0" Visibility="Collapsed"
                                    Click="ClearSearch_Click" ToolTip="Effacer (Échap)"/>
                        </Grid>
                        <Button Style="{StaticResource AccentButton}" Margin="10,0,0,0" Padding="14,8" Click="AddItem_Click"
                                ToolTip="Ajouter un bouton (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Ajouter" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tuiles -->
                <Grid x:Name="DropArea" Grid.Row="2" Background="Transparent" AllowDrop="True"
                      DragOver="Area_DragOver" Drop="Area_Drop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,22,20">
                        <ItemsControl x:Name="TilesList" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- État vide -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyGlyph" Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="44"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Opacity="0.6"/>
                        <TextBlock x:Name="EmptyTitle" Text="Ce groupe est vide" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" MaxWidth="360"
                                   Text="Glissez-déposez un programme (.exe, raccourci, dossier) ici, ou cliquez sur « Ajouter »."/>
                    </StackPanel>

                    <!-- Notification -->
                    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                            Padding="16,9" CornerRadius="10" Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <TextBlock x:Name="ToastText"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
