<Window x:Class="Lanceur.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanceur" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">
    <Border Style="{StaticResource DialogFrame}">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                       LineHeight="20"/>
            <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBox}" Margin="0,14,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Annuler" MinWidth="96"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="OK" MinWidth="96" Margin="8,0,0,0"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
